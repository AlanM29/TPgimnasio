<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <!-- pruebas.cs (del compañero) tiene código suelto con su propio punto de entrada:
       no se compila. Sus casos ya están incluidos en PruebasGenerales.cs -->
  <ItemGroup>
    <Compile Remove="Pruebas\pruebas.cs" />
  </ItemGroup>

  <!-- Estos archivos se copian solos junto al .exe cada vez que se compila -->
  <ItemGroup>
    <None Update="gimnasio.sqlite3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licencia.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licencia_BASICA_para_probar.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
